{
  "name": "flowcast",
  "version": "26.9.6",
  "description": "Automated production and delivery of radio shows and audio programs: FFmpeg conversion, FTP upload, scheduling and email alerts.",
  "author": "Graziano Melzi <hello@onairgarage.com> (https://onairgarage.com)",
  "homepage": "https://onairgarage.com/tools/flowcast/",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64",
    "build-portable": "electron-builder --win portable --x64",
    "manual": "node scripts/manual/run.js dist",
    "release:local": "node scripts/fetch-release.js",
    "build:mac": "electron-builder --mac --x64 --arm64",
    "build:linux": "electron-builder --linux AppImage --x64",
    "screenshots": "node scripts/screenshots/run.js"
  },
  "dependencies": {
    "basic-ftp": "^6.2.1",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.0.10"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.onairgarage.flowcast",
    "productName": "FlowCast",
    "publish": null,
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "src/**/*",
      "assets/**/*",
      "!assets/brand-set/**",
      "LICENSE"
    ],
    "copyright": "Copyright © 2026 Graziano Melzi",
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "assets/icon.ico",
      "artifactName": "FlowCast-Setup-${version}.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.icns",
      "category": "public.app-category.utilities",
      "artifactName": "FlowCast-${version}-${arch}.${ext}"
    },
    "dmg": {
      "artifactName": "FlowCast-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "assets/linux-icons",
      "category": "AudioVideo",
      "artifactName": "FlowCast-${version}-${arch}.${ext}",
      "synopsis": "Automated production and delivery of radio shows"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "license": "LICENSE",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "runAfterFinish": true
    },
    "extraResources": [],
    "asar": true
  }
}
