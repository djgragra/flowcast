{
  "name": "flowcast",
  "version": "26.9.1",
  "description": "Automated production and delivery of radio shows and audio programs: FFmpeg conversion, FTP upload, scheduling and email alerts.",
  "author": "Graziano Melzi <hello@onairgarage.com> (https://onairgarage.com)",
  "homepage": "https://onairgarage.com/tools/flowcast/",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64",
    "build-portable": "electron-builder --win portable --x64"
  },
  "dependencies": {
    "basic-ftp": "^6.2.1",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.0.10"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.onairgarage.flowcast",
    "productName": "FlowCast",
    "publish": null,
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "src/**/*",
      "assets/**/*",
      "LICENSE"
    ],
    "copyright": "Copyright © 2026 Graziano Melzi",
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "assets/icon.ico",
      "artifactName": "FlowCast-Setup-${version}.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "license": "LICENSE",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico"
    },
    "extraResources": [],
    "asar": true
  }
}
